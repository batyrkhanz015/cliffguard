# Claude API key, used server-side only (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Stripe secret key, test mode (sk_test_...), used server-side only
STRIPE_SECRET_KEY=
# Stripe publishable key, test mode (pk_test_...), safe to expose to the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Upstash Redis REST URL, for anonymous session state and rate limits
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token, used server-side only
UPSTASH_REDIS_REST_TOKEN=

# Claude API key, used server-side only (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Set to false to use the template and manual fallbacks instead of Claude
CLAUDE_ENABLED=true
# Most Claude calls allowed per day across all users
CLAUDE_DAILY_CALL_CAP=1000
# Public no-payment demo unlock. Must be exactly true; disabled when absent, even in development.
# Enabling in production deliberately gives EVERY visitor with a saved household demo access.
DEMO_UNLOCK_ENABLED=false
# Stripe checkout is deferred; no card is collected and this key is not used by demo unlock.
# Reserved Stripe secret key, test mode (sk_test_...), used server-side only (deferred: demo unlock is used instead)
STRIPE_SECRET_KEY=
# Upstash Redis REST URL, for anonymous session state and rate limits.
# Without it the app keeps state in memory in development; production requires it.
# The Vercel Upstash integration's KV_REST_API_URL / KV_REST_API_TOKEN names also work.
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token, used server-side only
UPSTASH_REDIS_REST_TOKEN=
